{
  "compilerOptions": {
	"resolveJsonModule": true,  
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
		"react",
		"react-dom",
		"vite/client",
		"some-other-global-lib",
		"vite-plugin-svgr/client"
	]
  },
  "include": ["src"]
}
